<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppFavoresEscritorio.VistaModelos.Notificaciones"
             xmlns:notif="clr-namespace:AppFavoresEscritorio.Modelos.Notificaciones"
             x:Class="AppFavoresEscritorio.Vistas.Notificaciones.PaginaNotificaciones"
             x:DataType="vm:NotificacionesVistaModelo"
             Title="{DynamicResource Nav_Notificaciones}"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="Notificaciones"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ColorTexto}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Marcar todas como leidas"
                    Style="{DynamicResource EstiloBotonSecundario}"
                    IsVisible="{Binding HayNoLeidas}"
                    Command="{Binding ComandoMarcarTodasLeidas}" />
        </Grid>

        <Label Grid.Row="0"
               Text="{Binding MensajeError}"
               TextColor="{DynamicResource ColorError}"
               IsVisible="{Binding HayError}"
               Margin="0,48,0,0" />

        <RefreshView Grid.Row="1"
                     Command="{Binding ComandoRefrescar}">
            <CollectionView ItemsSource="{Binding Notificaciones}">
                <CollectionView.EmptyView>
                    <Label Text="No tienes notificaciones"
                           TextColor="{DynamicResource ColorTextoSecundario}"
                           HorizontalOptions="Center"
                           Margin="0,32,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="notif:Notificacion">
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                BackgroundColor="{DynamicResource ColorSuperficie}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Leida}"
                                             Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ColorSuperficie}" />
                                    <Setter Property="Stroke" Value="{DynamicResource ColorPrimario}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Leida}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondo}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="6">
                                <Border BackgroundColor="{Binding ColorTipoVisual}"
                                        Padding="6,2"
                                        HorizontalOptions="Start"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding TextoTipo}"
                                           FontSize="11"
                                           TextColor="White" />
                                </Border>
                                <Label Text="{Binding Mensaje}"
                                       TextColor="{DynamicResource ColorTexto}" />
                                <Label Text="{Binding Fecha}"
                                       FontSize="12"
                                       TextColor="{DynamicResource ColorTextoSecundario}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding EstaOcupado}"
                           IsVisible="{Binding EstaOcupado}"
                           Color="{DynamicResource ColorPrimario}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
    </Grid>
</ContentPage>
