<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppFavoresEscritorio.VistaModelos.Chats"
             xmlns:chats="clr-namespace:AppFavoresEscritorio.Modelos.Chats"
             x:Class="AppFavoresEscritorio.Vistas.Chats.PaginaChatPrivado"
             x:DataType="vm:ChatPrivadoVistaModelo"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Padding="16,12"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              BackgroundColor="{DynamicResource ColorSuperficie}">
            <Button Grid.Column="0"
                    Text="←"
                    Clicked="OnVolverClicked"
                    Style="{DynamicResource EstiloBotonSecundario}"
                    WidthRequest="36" HeightRequest="36"
                    Padding="0" CornerRadius="18" />
            <Label Grid.Column="1"
                   Text="{Binding TituloChat}"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource ColorTexto}"
                   VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1">

            <CollectionView x:Name="mensajesCollectionView"
                            ItemsSource="{Binding Mensajes}">
                <CollectionView.EmptyView>
                    <Label Text="Todavía no hay mensajes. ¡Di hola!"
                           TextColor="{DynamicResource ColorTextoSecundario}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="chats:MensajePublico">
                        <VerticalStackLayout Padding="12,4">

                            <Border Padding="12,8"
                                    StrokeThickness="0"
                                    BackgroundColor="{DynamicResource ColorPrimario}"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="280"
                                    IsVisible="{Binding EsMio}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16,16,4,16" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Contenido}"
                                       TextColor="White"
                                       FontSize="14"
                                       LineBreakMode="WordWrap" />
                            </Border>

                            <Border Padding="12,8"
                                    Stroke="{DynamicResource ColorBorde}"
                                    StrokeThickness="1"
                                    BackgroundColor="{DynamicResource ColorSuperficie}"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="280"
                                    IsVisible="{Binding EsMio, Converter={StaticResource InvertirBoolConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16,16,16,4" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Emisor}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ColorPrimario}" />
                                    <Label Text="{Binding Contenido}"
                                           TextColor="{DynamicResource ColorTexto}"
                                           FontSize="14"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding MensajeError}"
                   TextColor="{DynamicResource ColorError}"
                   IsVisible="{Binding HayError}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="16" />

            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               Color="{DynamicResource ColorPrimario}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>

        <Grid Grid.Row="2"
              Padding="12,8"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              BackgroundColor="{DynamicResource ColorSuperficie}">

            <Border Grid.Column="0"
                    Stroke="{DynamicResource ColorBorde}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource ColorFondo}"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Entry Placeholder="Escribe un mensaje..."
                       Text="{Binding TextoNuevoMensaje, Mode=TwoWay}"
                       TextColor="{DynamicResource ColorTexto}"
                       PlaceholderColor="{DynamicResource ColorTextoSecundario}"
                       BackgroundColor="Transparent"
                       Margin="12,0"
                       ReturnCommand="{Binding ComandoEnviar}" />
            </Border>

            <Button Grid.Column="1"
                    Text="Enviar"
                    Command="{Binding ComandoEnviar}"
                    Style="{DynamicResource EstiloBotonPrimario}"
                    WidthRequest="80"
                    HeightRequest="44"
                    Padding="0"
                    CornerRadius="22"
                    VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>