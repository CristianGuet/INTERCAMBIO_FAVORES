<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppFavoresEscritorio.VistaModelos.Favores"
             xmlns:favores="clr-namespace:AppFavoresEscritorio.Modelos.Favores"
             xmlns:conv="clr-namespace:AppFavoresEscritorio.Utilidades"
             x:Class="AppFavoresEscritorio.Vistas.Favores.PaginaFavoresDisponibles"
             x:DataType="vm:FavoresDisponiblesVistaModelo"
             Title="{DynamicResource Nav_Favores}"
             BackgroundColor="{DynamicResource ColorFondo}">

    <ContentPage.Resources>
        <conv:InvertirBoolConverter x:Key="InvertirBoolConverter" />
    </ContentPage.Resources>

    <!-- SIN ToolbarItems: el botón va en la cabecera inline -->

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ══ CABECERA CON BOTÓN ══ -->
        <Grid Grid.Row="0"
              Padding="16,10"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{DynamicResource ColorSuperficie}">
            <Label Grid.Column="0"
                   Text="{DynamicResource Nav_Favores}"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ColorTexto}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="+ Publicar favor"
                    Clicked="OnPublicarFavorClicked"
                    Style="{DynamicResource EstiloBotonSecundario}"
                    HeightRequest="36"
                    Padding="12,0"
                    CornerRadius="18"
                    VerticalOptions="Center" />
        </Grid>

        <!-- ══ SEPARADOR ══ -->
        <BoxView Grid.Row="1"
                 HeightRequest="1"
                 BackgroundColor="{DynamicResource ColorBorde}" />

        <!-- ══ CONTENIDO ══ -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding ComandoRefrescar}">
            <Grid Padding="16" RowDefinitions="Auto,*">

                <Label Grid.Row="0"
                       Text="{Binding MensajeError}"
                       TextColor="{DynamicResource ColorError}"
                       IsVisible="{Binding HayError}"
                       Margin="0,0,0,8" />

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Favores}">
                    <CollectionView.EmptyView>
                        <Label Text="No hay favores disponibles"
                               TextColor="{DynamicResource ColorTextoSecundario}"
                               HorizontalOptions="Center"
                               Margin="0,32,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="favores:FavorPublico">
                            <Border StrokeShape="RoundRectangle 14"
                                    Stroke="{DynamicResource ColorBorde}"
                                    BackgroundColor="{DynamicResource ColorSuperficie}"
                                    Padding="16,14"
                                    Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="6">

                                    <Label Text="{Binding Titulo}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{DynamicResource ColorTexto}" />

                                    <Label Text="{Binding Descripcion}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           FontSize="13"
                                           TextColor="{DynamicResource ColorTextoSecundario}" />

                                    <HorizontalStackLayout Spacing="12">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{DynamicResource ColorBorde}"
                                                Padding="6,3">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding TextoModalidad}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource ColorTexto}" />
                                        </Border>

                                        <Label Text="{Binding ResumenCompensacion}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource ColorPrimario}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Label FontSize="11"
                                           TextColor="{DynamicResource ColorTextoSecundario}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Ofrecido por: " />
                                                <Span Text="{Binding IdUsuarioOfrece}"
                                                      FontAttributes="Italic" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Button Text="✓ Aceptar este favor"
                                            FontSize="13"
                                            Padding="14,8"
                                            HeightRequest="40"
                                            CornerRadius="10"
                                            HorizontalOptions="Start"
                                            BackgroundColor="{DynamicResource ColorExito}"
                                            TextColor="White"
                                            IsVisible="{Binding PuedeAceptar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.ComandoAceptarFavor}"
                                            CommandParameter="{Binding .}" />

                                    <Label Text="Este favor es tuyo"
                                           FontSize="11"
                                           FontAttributes="Italic"
                                           TextColor="{DynamicResource ColorTextoSecundario}"
                                           IsVisible="{Binding PuedeAceptar, Converter={StaticResource InvertirBoolConverter}}" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

    </Grid>
</ContentPage>