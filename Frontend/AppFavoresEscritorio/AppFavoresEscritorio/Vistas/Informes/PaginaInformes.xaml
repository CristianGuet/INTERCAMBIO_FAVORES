<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             x:Class="AppFavoresEscritorio.Vistas.Informes.PaginaInformes"
             Title="{DynamicResource Informes_Titulo}"
             BackgroundColor="{DynamicResource ColorFondo}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefrescarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="{DynamicResource Informes_Titulo}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ColorTexto}"
                       HorizontalOptions="Center" />

                <Label Text="{DynamicResource Informes_Subtitulo}"
                       FontSize="14"
                       TextColor="{DynamicResource ColorTextoSecundario}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,12" />

                <Label Text="{Binding MensajeError}"
                       TextColor="{DynamicResource ColorError}"
                       IsVisible="{Binding HayError}"
                       HorizontalOptions="Center" />

                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{DynamicResource ColorBorde}"
                        BackgroundColor="{DynamicResource ColorSuperficie}"
                        Padding="20"
                        Margin="0,8">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{DynamicResource Informes_Distribucion}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ColorTexto}"
                               HorizontalOptions="Center" />

                        <chart:SfCircularChart x:Name="graficoFavores"
                                               HeightRequest="280"
                                               WidthRequest="320"
                                               HorizontalOptions="Center"
                                               IsVisible="{Binding HayDatos}">
                            
                            <chart:SfCircularChart.Series>
                                <chart:DoughnutSeries x:Name="serieFavores"
                                                      XBindingPath="Estado"
                                                      YBindingPath="Cantidad" />
                            </chart:SfCircularChart.Series>
                        </chart:SfCircularChart>

                        <Label Text="{DynamicResource Informes_SinDatos}"
                               TextColor="{DynamicResource ColorTextoSecundario}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding SinDatos}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta resumen -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{DynamicResource ColorBorde}"
                        BackgroundColor="{DynamicResource ColorSuperficie}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{DynamicResource Informes_Resumen}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ColorTexto}"
                               HorizontalOptions="Center" />

                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,*"
                              RowSpacing="12"
                              ColumnSpacing="16">
                            <!-- Disponible -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    BackgroundColor="#10B981" Padding="8,4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label Text="{DynamicResource EstadoDisponible}"
                                           FontSize="12"
                                           TextColor="White" />
                                    <Label x:Name="lblDisponibles"
                                           Text="0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Aceptado -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    BackgroundColor="#F59E0B" Padding="8,4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label Text="{DynamicResource EstadoAceptado}"
                                           FontSize="12"
                                           TextColor="White" />
                                    <Label x:Name="lblAceptados"
                                           Text="0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Finalizado -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    BackgroundColor="#6366F1" Padding="8,4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label Text="{DynamicResource EstadoFinalizado}"
                                           FontSize="12"
                                           TextColor="White" />
                                    <Label x:Name="lblFinalizados"
                                           Text="0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Cancelado -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    BackgroundColor="#EF4444" Padding="8,4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label Text="{DynamicResource EstadoCancelado}"
                                           FontSize="12"
                                           TextColor="White" />
                                    <Label x:Name="lblCancelados"
                                           Text="0"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsCargando}"
                                   IsVisible="{Binding IsCargando}"
                                   Color="{DynamicResource ColorPrimario}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>