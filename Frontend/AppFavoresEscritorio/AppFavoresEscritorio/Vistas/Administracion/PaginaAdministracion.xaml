<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppFavoresEscritorio.Vistas.Administracion.PaginaAdministracion"
             Title="Administrar App"
             BackgroundColor="{DynamicResource ColorFondo}">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto">
            <Picker x:Name="categoriaPicker"
                    Title="Seleccionar categoría"
                    SelectedIndex="0"
                    SelectedIndexChanged="OnCategoriaChanged"
                    Margin="0,0,0,12">
            <Picker.Items>
                <x:String>Usuarios</x:String>
                <x:String>Favores</x:String>
                <x:String>Grupos</x:String>
            </Picker.Items>
        </Picker>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefrescarCommand}">
            <CollectionView x:Name="itemsCollectionView"
                            SelectionMode="None"
                            ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource ColorBorde}"
                                BackgroundColor="{DynamicResource ColorSuperficie}"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="{Binding DisplayText}"
                                       FontSize="14"
                                       TextColor="{DynamicResource ColorTexto}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Eliminar"
                                        BackgroundColor="{DynamicResource ColorError}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="12,6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.EliminarCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsCargando}"
                           IsVisible="{Binding IsCargando}"
                           Color="{DynamicResource ColorPrimario}"
                           HorizontalOptions="Center"
                           Margin="0,12" />
    </Grid>
</ContentPage>